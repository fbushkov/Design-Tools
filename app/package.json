{
  "name": "design-tools-app",
  "productName": "Design Tools",
  "version": "0.3.1",
  "description": "Рабочее место для разборов по базе Design Tools",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test:ui": "vite build && node tests/smoke.mjs",
    "release": "vite build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "ru.bushkovstudio.designtools",
    "productName": "Design Tools",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Design-Tools-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Design Tools"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fbushkov",
        "repo": "Design-Tools",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@heroui/react": "^2.8.10",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.18.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "vite": "^6.4.5",
    "wait-on": "^9.5.1"
  }
}
